{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://launchpad.dev/events/env.changed.v1.schema.json",
  "title": "env.changed.v1",
  "description": "Env var keys changed (never values)",
  "x-topic": "lp.projects",
  "x-key": "app_id",
  "x-producer": "projects",
  "x-consumers": [],
  "type": "object",
  "required": [
    "app_id",
    "keys",
    "scope"
  ],
  "additionalProperties": true,
  "properties": {
    "app_id": {
      "type": "string",
      "format": "uuid"
    },
    "keys": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "scope": {
      "type": "string",
      "enum": [
        "all",
        "production",
        "preview"
      ]
    }
  }
}