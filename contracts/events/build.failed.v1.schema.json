{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://launchpad.dev/events/build.failed.v1.schema.json",
  "title": "build.failed.v1",
  "description": "Build failed",
  "x-topic": "lp.builds",
  "x-key": "app_id",
  "x-producer": "builder",
  "x-consumers": [
    "deployer"
  ],
  "type": "object",
  "required": [
    "deployment_id",
    "app_id",
    "reason",
    "message"
  ],
  "additionalProperties": true,
  "properties": {
    "deployment_id": {
      "type": "string",
      "format": "uuid"
    },
    "app_id": {
      "type": "string",
      "format": "uuid"
    },
    "reason": {
      "type": "string",
      "enum": [
        "timeout",
        "cancelled",
        "clone_error",
        "detect_error",
        "build_error",
        "push_error",
        "internal"
      ]
    },
    "message": {
      "type": "string",
      "maxLength": 2048
    }
  }
}