{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://launchpad.dev/events/runtime.log.v1.schema.json",
  "title": "runtime.log.v1",
  "description": "Batch of runtime log lines (seq assigned by logs)",
  "x-topic": "lp.runtime",
  "x-key": "app_id",
  "x-producer": "runtime-agent",
  "x-consumers": [
    "logs"
  ],
  "type": "object",
  "required": [
    "deployment_id",
    "app_id",
    "container_id",
    "lines"
  ],
  "additionalProperties": true,
  "properties": {
    "deployment_id": {
      "type": "string",
      "format": "uuid"
    },
    "app_id": {
      "type": "string",
      "format": "uuid"
    },
    "container_id": {
      "type": "string"
    },
    "lines": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "type": "object",
        "required": [
          "ts",
          "stream",
          "line"
        ],
        "properties": {
          "ts": {
            "type": "string",
            "format": "date-time"
          },
          "stream": {
            "type": "string",
            "enum": [
              "stdout",
              "stderr"
            ]
          },
          "line": {
            "type": "string",
            "maxLength": 8192
          }
        }
      }
    }
  }
}